{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with verification status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "verificationMethod": { "type": "string" },
        "photoUrl": { "type": "string" },
        "deviceModel": { "type": "string" },
        "osVersion": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "name", "isVerified"]
    },
    "UserZikrData": {
      "title": "UserZikrData",
      "description": "User zikr history, counts and synced data across devices",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "zikrsJson": { "type": "string" },
        "historyJson": { "type": "string" },
        "streakJson": { "type": "string" },
        "settingsJson": { "type": "string" },
        "savedHighlightsJson": { "type": "string" },
        "totalCount": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "totalCount", "updatedAt"]
    },
    "ConnectionHealth": {
      "title": "ConnectionHealth",
      "description": "Document used to validate connectivity to Firestore backend",
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "InfoRequest": {
      "title": "InfoRequest",
      "description": "User submitted message requesting missing Islamic info or content updates from the AI assistant",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "pageModule": { "type": "string", "maxLength": 100 },
        "pageTitle": { "type": "string", "maxLength": 300 },
        "userNote": { "type": "string", "maxLength": 2000 },
        "senderName": { "type": "string", "maxLength": 120 },
        "senderContact": { "type": "string", "maxLength": 200 },
        "senderKey": { "type": "string", "maxLength": 128 },
        "language": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "enum": ["pending", "reviewed", "resolved"] },
        "createdAtMs": { "type": "number" },
        "updatedAtMs": { "type": "number" }
      },
      "required": ["id", "question", "status", "createdAtMs"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile and verification status"
    },
    "/users/{userId}/data/{docId}": {
      "schema": "UserZikrData",
      "description": "Stores user zikr history, streak, and synced counts across all devices"
    },
    "/info_requests/{requestId}": {
      "schema": "InfoRequest",
      "description": "Stores user messages requesting missing information found via the AI assistant"
    },
    "/test/{testId}": {
      "schema": "ConnectionHealth",
      "description": "Health check connection test document"
    }
  }
}
