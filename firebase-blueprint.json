{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Normalized server users table record with scrypt password_hash",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "maxLength": 200 },
        "password_hash": { "type": "string", "maxLength": 256 },
        "auth_provider": { "type": "string", "enum": ["email", "google"] },
        "email_verified": { "type": "boolean" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "created_at": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "email", "created_at"]
    },
    "UserProfileRecord": {
      "title": "UserProfileRecord",
      "description": "Normalized server profiles table linked to users.id",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "photo": { "type": "string", "maxLength": 60000 },
        "phone": { "type": "string", "maxLength": 40 },
        "preferences": { "type": "object" },
        "updated_at": { "type": "string", "maxLength": 64 }
      },
      "required": ["user_id", "updated_at"]
    },
    "UserSession": {
      "title": "UserSession",
      "description": "Normalized server sessions table storing SHA-256 session_token_hash and device metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "user_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "session_token_hash": { "type": "string", "minLength": 64, "maxLength": 128 },
        "expires_at": { "type": "number" },
        "device": { "type": "string", "maxLength": 200 },
        "created_at": { "type": "string", "maxLength": 64 },
        "last_seen_at": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "user_id", "session_token_hash", "expires_at", "device"]
    },
    "UserDataRecord": {
      "title": "UserDataRecord",
      "description": "Normalized server user_data table storing saved_items, settings, and activity",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "saved_items": { "type": "object" },
        "settings": { "type": "object" },
        "activity": { "type": "object" },
        "updated_at": { "type": "string", "maxLength": 64 }
      },
      "required": ["user_id", "saved_items", "settings", "activity", "updated_at"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Firestore user document storing owner profile, telemetry, and synced counts",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 40 },
        "isVerified": { "type": "boolean" },
        "verificationMethod": { "type": "string", "maxLength": 32 },
        "photoUrl": { "type": "string", "maxLength": 60000 },
        "location": { "type": "string", "maxLength": 200 },
        "deviceModel": { "type": "string", "maxLength": 120 },
        "osVersion": { "type": "string", "maxLength": 64 },
        "senderDeviceId": { "type": "string", "maxLength": 128 },
        "profileJson": { "type": "string", "maxLength": 100000 },
        "zikrsJson": { "type": "string", "maxLength": 250000 },
        "historyJson": { "type": "string", "maxLength": 500000 },
        "aamalLogsJson": { "type": "string", "maxLength": 300000 },
        "settingsJson": { "type": "string", "maxLength": 20000 },
        "totalCount": { "type": "number" },
        "lifetimeTotalCount": { "type": "number" },
        "lastActiveAt": { "type": "string", "maxLength": 64 },
        "lastActiveAtMs": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedAtMs": { "type": "number" }
      }
    },
    "UserZikrData": {
      "title": "UserZikrData",
      "description": "User zikr history, aamal logs, and library highlights stored in subcollection",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "zikrsJson": { "type": "string", "maxLength": 250000 },
        "historyJson": { "type": "string", "maxLength": 500000 },
        "aamalLogsJson": { "type": "string", "maxLength": 500000 },
        "streakJson": { "type": "string", "maxLength": 50000 },
        "settingsJson": { "type": "string", "maxLength": 20000 },
        "savedHighlightsJson": { "type": "string", "maxLength": 500000 },
        "target": { "type": "string", "maxLength": 200 },
        "code": { "type": "string", "maxLength": 16 },
        "purpose": { "type": "string", "maxLength": 32 },
        "type": { "type": "string", "maxLength": 32 },
        "expiresAt": { "type": "number" },
        "totalCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedAtMs": { "type": "number" }
      }
    },
    "ConnectionHealth": {
      "title": "ConnectionHealth",
      "description": "Document used to validate connectivity to Firestore backend",
      "type": "object",
      "properties": {
        "status": { "type": "string", "maxLength": 64 },
        "timestamp": { "type": "string", "maxLength": 64 }
      }
    },
    "InfoRequest": {
      "title": "InfoRequest",
      "description": "User submitted message requesting missing Islamic info or content updates from the AI assistant",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "pageModule": { "type": "string", "maxLength": 100 },
        "pageTitle": { "type": "string", "maxLength": 300 },
        "userNote": { "type": "string", "maxLength": 2000 },
        "senderName": { "type": "string", "maxLength": 120 },
        "senderContact": { "type": "string", "maxLength": 200 },
        "senderKey": { "type": "string", "maxLength": 128 },
        "language": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "enum": ["pending", "reviewed", "resolved"] },
        "createdAtMs": { "type": "number" },
        "updatedAtMs": { "type": "number" }
      },
      "required": ["id", "question", "status", "createdAtMs"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores verified user profile and synced zikr counts (owner/admin access only)"
    },
    "/users/{userId}/data/{docId}": {
      "schema": "UserZikrData",
      "description": "Stores user zikr history, aamal logs, and highlights sub-documents (Master Gate via parent user doc)"
    },
    "/info_requests/{requestId}": {
      "schema": "InfoRequest",
      "description": "Stores user messages requesting missing information found via the AI assistant"
    },
    "/test/{testId}": {
      "schema": "ConnectionHealth",
      "description": "Read-only health check connection test document"
    }
  }
}
