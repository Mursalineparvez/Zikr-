rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if userId is string && userId.size() > 0 && userId.size() <= 256;

      match /{allChildren=**} {
        allow read, write: if userId is string && userId.size() > 0 && userId.size() <= 256;
      }
    }

    match /test/{testId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

