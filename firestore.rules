rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /users/{userId} {
      allow read, write: if isValidId(userId);

      match /data/{docId} {
        allow read, write: if isValidId(userId) && isValidId(docId);
      }
    }

    match /test/{testId} {
      allow read: if isValidId(testId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
